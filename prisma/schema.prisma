generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH / RBAC ====================

model Utilisateur {
  id_utilisateur Int                  @id @default(autoincrement())
  tenant_id      Int
  nom            String
  prenom         String
  email          String               @unique
  password_hash  String
  role           String
  actif          Boolean              @default(true)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  overrides      UserAccessOverride[]

  @@map("utilisateur")
}

model AccessDomain {
  id_domain  Int                  @id @default(autoincrement())
  code       String               @unique
  label      String
  actif      Boolean              @default(true)
  overrides  UserAccessOverride[]
  roleMatrix RoleAccessMatrix[]

  @@map("access_domain")
}

model UserAccessOverride {
  id_utilisateur Int
  id_domain      Int
  can_read       Boolean?
  can_write      Boolean?
  can_delete     Boolean?
  can_manage     Boolean?
  utilisateur    Utilisateur  @relation(fields: [id_utilisateur], references: [id_utilisateur])
  domain         AccessDomain @relation(fields: [id_domain], references: [id_domain])

  @@id([id_utilisateur, id_domain])
  @@map("user_access_override")
}

model Role {
  id_role Int                @id @default(autoincrement())
  code    String             @unique
  label   String
  actif   Boolean            @default(true)
  matrix  RoleAccessMatrix[]

  @@map("role")
}

model RoleAccessMatrix {
  id_role    Int
  id_domain  Int
  can_read   Boolean      @default(false)
  can_write  Boolean      @default(false)
  can_delete Boolean      @default(false)
  can_manage Boolean      @default(false)
  role       Role         @relation(fields: [id_role], references: [id_role])
  domain     AccessDomain @relation(fields: [id_domain], references: [id_domain])

  @@id([id_role, id_domain])
  @@map("role_access_matrix")
}

// ==================== STOCK ====================
// stock_actuel = photo (current snapshot, source of truth)
// stock_mouvement = film (append-only journal)

model StockActuel {
  id                Int      @id @default(autoincrement())
  tenant_id         Int
  id_lot            Int
  id_pdv            Int
  quantite          Decimal  @default(0) @db.Decimal(12, 3)
  quantite_reservee Decimal  @default(0) @db.Decimal(12, 3)
  created_by        Int?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([tenant_id, id_lot, id_pdv])
  @@map("stock_actuel")
}

model StockSnapshot {
  id_snapshot    Int             @id @default(autoincrement())
  tenant_id      Int
  id_pdv         Int
  periode        String
  created_at     DateTime        @default(now())
  lignes         SnapshotLigne[]

  @@map("stock_snapshot")
}

model SnapshotLigne {
  id_ligne       Int           @id @default(autoincrement())
  id_snapshot    Int
  id_produit     Int
  quantite       Decimal       @db.Decimal(10, 2)
  snapshot       StockSnapshot @relation(fields: [id_snapshot], references: [id_snapshot])

  @@map("snapshot_ligne")
}

model StockMouvement {
  id_stock_mouvement Int      @id @default(autoincrement())
  tenant_id          Int
  id_lot             Int
  type               String   // entree | sortie | reservation | annulation_reservation | ajustement | transfert
  quantite           Decimal  @db.Decimal(12, 3)
  before_qty         Decimal? @db.Decimal(12, 3)
  after_qty          Decimal? @db.Decimal(12, 3)
  source_type        String   // VENTE | LIVRAISON | AJUSTEMENT | TRANSFERT | RETOUR
  source_id          Int?
  date_mouvement     DateTime @default(now())
  created_at         DateTime @default(now())
  created_by         Int?

  @@map("stock_mouvement")
}

model StockTransfert {
  id_stock_transfert          Int       @id @default(autoincrement())
  id_point_vente_source       Int
  id_point_vente_destination  Int
  id_utilisateur              Int
  date_transfert              DateTime  @default(now())
  commentaire                 String?
  created_at                  DateTime  @default(now())
  created_by                  Int?
  updated_at                  DateTime?
  updated_by                  Int?
  deleted_at                  DateTime?

  @@map("stock_transfert")
}

// ==================== PRODUITS ====================

model ProduitCatalogue {
  id_produit       Int       @id @default(autoincrement())
  tenant_id        Int
  id_collaborateur Int
  nom              String
  description      String?
  categorie        String?
  sku              String?
  unite            String?
  seuil_alerte     Int?
  image_url        String?
  statut           String    @default("actif") // actif | archive
  created_by       Int?
  modified_by      Int?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  modified_at      DateTime?
  deleted_at       DateTime?

  @@map("produit_catalogue")
}

// ==================== COLLABORATEURS ====================

model Collaborateur {
  id_collaborateur Int      @id @default(autoincrement())
  tenant_id        Int
  nom              String
  prenom           String?
  email            String?
  telephone        String?
  poste            String?
  adresse          String?
  statut           String   @default("actif") // actif | archive
  client_uuid      String?  // idempotence key for offline-first sync
  date_adhesion    DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([tenant_id, client_uuid])
  @@map("collaborateur")
}

// ==================== POINTS DE VENTE ====================

model PointDeVente {
  id_pdv          Int       @id @default(autoincrement())
  tenant_id       Int
  nom             String
  quartier        String?
  ville           String?
  adresse         String?
  telephone       String?
  email           String?
  responsable_id  Int?
  statut          String    @default("actif") // actif | ferme | archive
  date_ouverture  DateTime?
  date_fermeture  DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@map("point_de_vente")
}

// ==================== LIVRAISONS (header + lines) ====================

model Livraison {
  id_livraison     Int             @id @default(autoincrement())
  tenant_id        Int
  id_collaborateur Int
  id_pdv           Int
  client_uuid      String?
  date_livraison   DateTime        @default(now())
  reference        String?
  commentaire      String?
  created_at       DateTime        @default(now())
  items            LivraisonItem[]

  @@unique([tenant_id, client_uuid])
  @@map("livraison")
}

model LivraisonItem {
  id_lot             Int       @id @default(autoincrement())
  tenant_id          Int
  id_produit         Int
  id_livraison       Int
  id_pdv             Int
  prix_initial       Decimal   @db.Decimal(10, 2)
  marge              Decimal   @db.Decimal(10, 2)
  quantite_initiale  Decimal   @db.Decimal(12, 3)
  quantite_remboursee Decimal  @default(0) @db.Decimal(12, 3)
  id_lot_parent      Int?
  statut             String    @default("en_stock") // en_stock | vendu | archive
  date_livraison     DateTime  @default(now())
  created_by         Int?
  modified_by        Int?
  deleted_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  livraison          Livraison @relation(fields: [id_livraison], references: [id_livraison])

  @@map("livraison_item")
}

// ==================== COMMANDES ====================

model Commande {
  id_commande    Int             @id @default(autoincrement())
  id_client      Int
  id_pdv         Int
  cree_par_id    Int
  statut         String          @default("reservee") // reservee | confirmee | annulee
  date_commande  DateTime        @default(now())
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  lignes         CommandeLigne[]

  @@map("commande")
}

model CommandeLigne {
  id                 Int      @id @default(autoincrement())
  id_commande        Int
  id_lot             Int
  id_collaborateur   Int
  quantite_reservee  Int
  prix_initial       Decimal  @db.Decimal(10, 2)
  marge              Decimal  @db.Decimal(10, 2)
  created_at         DateTime @default(now())
  commande           Commande @relation(fields: [id_commande], references: [id_commande])

  @@map("commande_ligne")
}

// ==================== CLIENTS ====================

model Client {
  id_client         Int      @id @default(autoincrement())
  tenant_id         Int
  nom               String
  prenom            String?
  email             String?
  telephone         String?
  adresse           String?
  date_inscription  DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("client")
}

// ==================== VENTES ====================

model Vente {
  id_vente             Int            @id @default(autoincrement())
  tenant_id            Int
  id_commande          Int?
  id_client            Int
  id_point_vente       Int
  client_uuid          String?
  date_vente           DateTime       @default(now())
  enregistre_par_admin_id Int
  id_utilisateur       Int?
  statut               String         @default("payee") // en_attente_paiement | payee | annulee | retournee
  montant_ht           Decimal?       @db.Decimal(15, 2)
  montant_tva          Decimal?       @default(0) @db.Decimal(15, 2)
  montant_marge        Decimal?       @db.Decimal(15, 2)
  montant_total        Decimal?       @db.Decimal(15, 2)
  deleted              Boolean        @default(false)
  deleted_at           DateTime?
  raison_suppression   String?
  created_at           DateTime       @default(now())
  articles             VenteArticle[]

  @@unique([tenant_id, client_uuid])
  @@map("vente")
}

model VenteArticle {
  id_ligne          Int      @id @default(autoincrement())
  tenant_id         Int
  id_vente          Int
  id_lot            Int
  id_collaborateur  Int
  quantite_vendue   Int
  prix_initial      Decimal  @db.Decimal(10, 2)
  marge             Decimal  @db.Decimal(10, 2)
  montant_ht        Decimal? @db.Decimal(15, 2)
  montant_tva       Decimal? @default(0) @db.Decimal(15, 2)
  montant_marge     Decimal? @db.Decimal(15, 2)
  deleted           Boolean  @default(false)
  deleted_at        DateTime?
  created_at        DateTime @default(now())
  quantite_retournee Decimal @default(0) @db.Decimal(12, 3)
  vente             Vente    @relation(fields: [id_vente], references: [id_vente])

  @@map("vente_article")
}

// ==================== ENCAISSEMENTS ====================

model Encaissement {
  id_encaissement   Int      @id @default(autoincrement())
  tenant_id         Int
  id_vente          Int
  montant           Decimal  @db.Decimal(15, 2)
  mode              String   @default("cash") // cash | mobile_money | carte | virement | autre
  reference         String?
  date_encaissement DateTime @default(now())
  cree_par_id       Int

  @@map("encaissement")
}

// ==================== FINANCE ====================

model TransactionFinanciere {
  id_transaction_financiere Int      @id @default(autoincrement())
  tenant_id                 Int
  type                      String   // IN | OUT
  montant                   Decimal  @db.Decimal(15, 2)
  date_transaction          DateTime @default(now())
  id_categorie_financiere   Int
  description               String?
  source_module             String
  source_id                 Int?
  created_at                DateTime @default(now())
  created_by                Int

  @@map("transaction_financiere")
}

model FinancialCategory {
  id_category  Int      @id @default(autoincrement())
  tenant_id    Int
  name         String
  type         String
  actif        Boolean  @default(true)
  created_at   DateTime @default(now())

  @@map("financial_category")
}

// ==================== ABONNEMENTS ====================

model Abonnement {
  id_abonnement      Int                       @id @default(autoincrement())
  tenant_id          Int
  nom                String
  montant            Decimal                   @db.Decimal(10, 2)
  periodicite        String
  impact_type        String?
  impact_montant     Decimal?                  @db.Decimal(10, 2)
  impact_pourcentage Decimal?                  @db.Decimal(5, 2)
  actif              Boolean                   @default(true)
  created_at         DateTime                  @default(now())
  updated_at         DateTime                  @updatedAt
  paiements          AbonnementPaiement[]
  collaborateurs     AbonnementCollaborateur[]

  @@map("abonnement")
}

model AbonnementPaiement {
  id_paiement   Int        @id @default(autoincrement())
  id_abonnement Int
  montant       Decimal    @db.Decimal(10, 2)
  date_paiement DateTime   @default(now())
  abonnement    Abonnement @relation(fields: [id_abonnement], references: [id_abonnement])

  @@map("abonnement_paiement")
}

model AbonnementCollaborateur {
  id_abonnement    Int
  id_collaborateur Int
  date_debut       DateTime?
  date_fin         DateTime?
  created_at       DateTime  @default(now())
  abonnement       Abonnement @relation(fields: [id_abonnement], references: [id_abonnement])

  @@id([id_abonnement, id_collaborateur])
  @@map("abonnement_collaborateur")
}

// ==================== STOCK AJUSTEMENT (legacy — use stock_mouvement) ====================

model StockAjustement {
  id_stock_ajustement Int       @id @default(autoincrement())
  id_lot              Int
  id_utilisateur      Int
  type                String    // perte | casse | inventaire | correction
  quantite            Decimal   @db.Decimal(12, 3)
  motif               String?
  date_ajustement     DateTime  @default(now())
  statut              String    @default("valide") // brouillon | valide | annule
  created_at          DateTime  @default(now())
  created_by          Int?
  updated_at          DateTime?
  updated_by          Int?
  deleted_at          DateTime?

  @@map("stock_ajustement")
}

// ==================== RETOUR COLLABORATEUR (legacy — use stock_mouvement) ====================

model RetourCollaborateur {
  id_retour_collaborateur Int       @id @default(autoincrement())
  id_lot                  Int
  id_collaborateur        Int
  id_utilisateur          Int
  quantite_retournee      Int
  date_retour             DateTime  @default(now())
  motif                   String?
  created_at              DateTime  @default(now())
  created_by              Int?
  updated_at              DateTime?
  updated_by              Int?
  deleted_at              DateTime?

  @@map("retour_collaborateur")
}
