generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  id_utilisateur Int                  @id @default(autoincrement())
  tenant_id      Int
  nom            String
  prenom         String
  email          String               @unique
  password_hash  String
  role           String
  actif          Boolean              @default(true)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  overrides      UserAccessOverride[]

  @@map("utilisateur")
}

model AccessDomain {
  id_domain  Int                  @id @default(autoincrement())
  code       String               @unique
  label      String
  actif      Boolean              @default(true)
  roleMatrix RoleAccessMatrix[]
  overrides  UserAccessOverride[]

  @@map("access_domain")
}

model UserAccessOverride {
  id_utilisateur Int
  id_domain      Int
  can_read       Boolean?
  can_write      Boolean?
  can_delete     Boolean?
  can_manage     Boolean?
  domain         AccessDomain @relation(fields: [id_domain], references: [id_domain])
  utilisateur    Utilisateur  @relation(fields: [id_utilisateur], references: [id_utilisateur])

  @@id([id_utilisateur, id_domain])
  @@map("user_access_override")
}

model Role {
  id_role Int                @id @default(autoincrement())
  code    String             @unique
  label   String
  actif   Boolean            @default(true)
  matrix  RoleAccessMatrix[]

  @@map("role")
}

model RoleAccessMatrix {
  id_role    Int
  id_domain  Int
  can_read   Boolean      @default(false)
  can_write  Boolean      @default(false)
  can_delete Boolean      @default(false)
  can_manage Boolean      @default(false)
  domain     AccessDomain @relation(fields: [id_domain], references: [id_domain])
  role       Role         @relation(fields: [id_role], references: [id_role])

  @@id([id_role, id_domain])
  @@map("role_access_matrix")
}

model StockActuel {
  id                Int      @id @default(autoincrement())
  tenant_id         Int
  id_lot            Int
  id_pdv            Int
  quantite          Decimal  @default(0) @db.Decimal(12, 3)
  quantite_reservee Decimal  @default(0) @db.Decimal(12, 3)
  created_by        Int?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([tenant_id, id_lot, id_pdv])
  @@map("stock_actuel")
}

model StockSnapshot {
  id_snapshot Int             @id @default(autoincrement())
  tenant_id   Int
  id_pdv      Int
  periode     String
  created_at  DateTime        @default(now())
  lignes      SnapshotLigne[]

  @@map("stock_snapshot")
}

model SnapshotLigne {
  id_ligne    Int           @id @default(autoincrement())
  id_snapshot Int
  id_produit  Int
  quantite    Decimal       @db.Decimal(10, 2)
  snapshot    StockSnapshot @relation(fields: [id_snapshot], references: [id_snapshot])

  @@map("snapshot_ligne")
}

model StockMouvement {
  id_stock_mouvement Int      @id @default(autoincrement())
  tenant_id          Int
  id_lot             Int
  type               String
  quantite           Decimal  @db.Decimal(12, 3)
  before_qty         Decimal? @db.Decimal(12, 3)
  after_qty          Decimal? @db.Decimal(12, 3)
  source_type        String
  source_id          Int?
  date_mouvement     DateTime @default(now())
  created_at         DateTime @default(now())
  created_by         Int?

  @@map("stock_mouvement")
}

model StockTransfert {
  id_stock_transfert         Int       @id @default(autoincrement())
  id_point_vente_source      Int
  id_point_vente_destination Int
  id_utilisateur             Int
  date_transfert             DateTime  @default(now())
  commentaire                String?
  created_at                 DateTime  @default(now())
  created_by                 Int?
  updated_at                 DateTime?
  updated_by                 Int?
  deleted_at                 DateTime?

  @@map("stock_transfert")
}

model UniteDeMesure {
  id_unite    Int                @id @default(autoincrement())
  tenant_id   Int
  code        String
  label       String
  est_decimal Boolean            @default(false)
  precision   Int                @default(0)
  actif       Boolean            @default(true)
  created_at  DateTime           @default(now())
  produits    ProduitCatalogue[]

  @@unique([tenant_id, code])
  @@map("unite_de_mesure")
}

model ProduitCatalogue {
  id_produit       Int            @id @default(autoincrement())
  tenant_id        Int
  id_collaborateur Int
  nom              String
  description      String?
  categorie        String?
  sku              String?
  /// @deprecated — conservé pour compatibilité lectures ; utiliser id_unite
  unite            String?
  id_unite         Int?
  seuil_alerte     Decimal?       @db.Decimal(10, 3)
  image_url        String?
  statut           String         @default("actif")
  created_by       Int?
  modified_by      Int?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  modified_at      DateTime?
  deleted_at       DateTime?
  unite_mesure     UniteDeMesure? @relation(fields: [id_unite], references: [id_unite])

  @@map("produit_catalogue")
}

model Collaborateur {
  id_collaborateur Int      @id @default(autoincrement())
  tenant_id        Int
  nom              String
  prenom           String?
  email            String?
  telephone        String?
  poste            String?
  adresse          String?
  statut           String   @default("actif")
  client_uuid      String?
  date_adhesion    DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([tenant_id, client_uuid])
  @@map("collaborateur")
}

model PointDeVente {
  id_pdv         Int       @id @default(autoincrement())
  tenant_id      Int
  nom            String
  quartier       String?
  ville          String?
  adresse        String?
  telephone      String?
  email          String?
  responsable_id Int?
  statut         String    @default("actif")
  date_ouverture DateTime?
  date_fermeture DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("point_de_vente")
}

model Livraison {
  id_livraison     Int             @id @default(autoincrement())
  tenant_id        Int
  id_collaborateur Int
  id_pdv           Int
  client_uuid      String?
  date_livraison   DateTime        @default(now())
  reference        String?
  commentaire      String?
  created_at       DateTime        @default(now())
  items            LivraisonItem[]

  @@unique([tenant_id, client_uuid])
  @@map("livraison")
}

model LivraisonItem {
  id_lot              Int       @id @default(autoincrement())
  tenant_id           Int
  id_produit          Int
  id_livraison        Int
  id_pdv              Int
  prix_initial        Decimal   @db.Decimal(10, 2)
  marge               Decimal   @db.Decimal(10, 2)
  quantite_initiale   Decimal   @db.Decimal(12, 3)
  quantite_remboursee Decimal   @default(0) @db.Decimal(12, 3)
  id_lot_parent       Int?
  statut              String    @default("en_stock")
  date_livraison      DateTime  @default(now())
  created_by          Int?
  modified_by         Int?
  deleted_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  livraison           Livraison @relation(fields: [id_livraison], references: [id_livraison])

  @@map("livraison_item")
}

model Commande {
  id_commande   Int             @id @default(autoincrement())
  id_client     Int
  id_pdv        Int
  cree_par_id   Int
  statut        String          @default("reservee")
  date_commande DateTime        @default(now())
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  lignes        CommandeLigne[]

  @@map("commande")
}

model CommandeLigne {
  id                Int      @id @default(autoincrement())
  id_commande       Int
  id_lot            Int
  id_collaborateur  Int
  quantite_reservee Decimal  @db.Decimal(12, 3)
  prix_initial      Decimal  @db.Decimal(10, 2)
  marge             Decimal  @db.Decimal(10, 2)
  created_at        DateTime @default(now())
  commande          Commande @relation(fields: [id_commande], references: [id_commande])

  @@map("commande_ligne")
}

model Client {
  id_client        Int      @id @default(autoincrement())
  tenant_id        Int
  nom              String
  prenom           String?
  email            String?
  telephone        String?
  adresse          String?
  date_inscription DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("client")
}

model Vente {
  id_vente                Int            @id @default(autoincrement())
  tenant_id               Int
  id_commande             Int?
  id_client               Int
  id_point_vente          Int
  client_uuid             String?
  date_vente              DateTime       @default(now())
  enregistre_par_admin_id Int
  id_utilisateur          Int?
  statut                  String         @default("payee")
  montant_ht              Decimal?       @db.Decimal(15, 2)
  montant_tva             Decimal?       @default(0) @db.Decimal(15, 2)
  montant_marge           Decimal?       @db.Decimal(15, 2)
  montant_total           Decimal?       @db.Decimal(15, 2)
  deleted                 Boolean        @default(false)
  deleted_at              DateTime?
  raison_suppression      String?
  created_at              DateTime       @default(now())
  articles                VenteArticle[]

  @@unique([tenant_id, client_uuid])
  @@map("vente")
}

model VenteArticle {
  id_ligne           Int       @id @default(autoincrement())
  tenant_id          Int
  id_vente           Int
  id_lot             Int
  id_collaborateur   Int
  quantite_vendue    Decimal   @db.Decimal(12, 3)
  prix_initial       Decimal   @db.Decimal(10, 2)
  marge              Decimal   @db.Decimal(10, 2)
  montant_ht         Decimal?  @db.Decimal(15, 2)
  montant_tva        Decimal?  @default(0) @db.Decimal(15, 2)
  montant_marge      Decimal?  @db.Decimal(15, 2)
  deleted            Boolean   @default(false)
  deleted_at         DateTime?
  created_at         DateTime  @default(now())
  quantite_retournee Decimal   @default(0) @db.Decimal(12, 3)
  /// Motif de la dernière annulation partielle sur cette ligne (non-faisant-foi ; source de vérité = stock_mouvement)
  raison_suppression String?
  vente              Vente     @relation(fields: [id_vente], references: [id_vente])

  @@map("vente_article")
}

model Encaissement {
  id_encaissement   Int      @id @default(autoincrement())
  tenant_id         Int
  id_vente          Int
  montant           Decimal  @db.Decimal(15, 2)
  mode              String   @default("cash")
  reference         String?
  date_encaissement DateTime @default(now())
  cree_par_id       Int

  @@map("encaissement")
}

model TransactionFinanciere {
  id_transaction_financiere Int                  @id @default(autoincrement())
  tenant_id                 Int
  type                      String
  montant                   Decimal              @db.Decimal(15, 2)
  date_transaction          DateTime             @default(now())
  id_categorie_financiere   Int
  description               String?
  source_module             String
  source_id                 Int?
  created_at                DateTime             @default(now())
  created_by                Int
  paiement_abonnement       PaiementAbonnement[]

  @@map("transaction_financiere")
}

model FinancialCategory {
  id_category Int      @id @default(autoincrement())
  tenant_id   Int
  name        String
  type        String
  actif       Boolean  @default(true)
  created_at  DateTime @default(now())

  @@map("financial_category")
}

/// Offre commerciale d'abonnement proposée par PEJAA.
/// Abonnement.montant est le prix catalogue actuel — sa modification ne rétroagit
/// jamais sur les SouscriptionAbonnement, EcheanceAbonnement ou PaiementAbonnement existants.
///
/// Cycle de vie du statut :
/// ACTIVE   → les nouvelles souscriptions sont autorisées
/// INACTIVE → aucune nouvelle souscription, les souscriptions existantes continuent
/// ARCHIVED → offre conservée uniquement pour l'historique
///
/// Contrainte de suppression physique :
/// - interdit si au moins une SouscriptionAbonnement existe (même annulée)
/// - autorisé uniquement si aucune souscription n'a jamais existé
/// - désactiver une offre ne doit JAMAIS annuler automatiquement les souscriptions existantes
model Abonnement {
  id_abonnement Int                      @id @default(autoincrement())
  tenant_id     Int
  nom           String
  description   String?
  /// Prix catalogue actuel de l'offre. Évolutif — ne jamais utiliser pour reconstruire l'historique.
  montant       Decimal                  @db.Decimal(10, 2)
  /// mensuel | trimestriel | annuel | ponctuel
  periodicite   String
  /// ACTIVE | INACTIVE | ARCHIVED
  statut        String                   @default("ACTIVE")
  created_by    Int?
  created_at    DateTime                 @default(now())
  modified_by   Int?
  modified_at   DateTime?
  souscriptions SouscriptionAbonnement[]

  @@map("abonnement")
}

/// Relation commerciale entre un collaborateur et une offre d'abonnement.
/// Peut représenter une souscription actuellement active, suspendue, terminée ou annulée.
///
/// montant = tarif actuellement applicable à CE collaborateur.
/// Il peut différer de Abonnement.montant (tarif catalogue).
/// Ce n'est PAS le montant historique figé des échéances — c'est le tarif
/// en vigueur qui sera utilisé lors de la prochaine génération d'échéance.
///
/// Les montants historiques sont portés par EcheanceAbonnement.montant.
///
/// Cycle de vie du statut :
/// ACTIVE    → souscription en cours, génération d'échéances autorisée
/// SUSPENDUE → temporairement inactive, pas de nouvelles échéances
/// TERMINEE  → arrivée à date_fin, historique conservé
/// ANNULEE   → annulation métier explicite (canceled_at renseigné)
///
/// Une migration commerciale (changement d'offre ou de tarif structurant)
/// se représente comme : ancienne souscription date_fin → nouvelle souscription.
/// Ne jamais réécrire id_abonnement ou montant sur une souscription existante.
model SouscriptionAbonnement {
  id_souscription_abonnement Int                  @id @default(autoincrement())
  tenant_id                  Int
  id_abonnement              Int
  id_collaborateur           Int
  /// Tarif actuellement applicable à ce collaborateur.
  /// Peut différer du catalogue. Utilisé pour générer les prochaines échéances.
  montant                    Decimal              @db.Decimal(10, 2)
  renouvellement_auto        Boolean              @default(true)
  date_debut                 DateTime
  date_fin                   DateTime?
  /// ACTIVE | SUSPENDUE | TERMINEE | ANNULEE
  statut                     String               @default("ACTIVE")
  /// Renseigner pour annuler — ne jamais supprimer physiquement.
  canceled_at                DateTime?
  canceled_by                Int?
  created_by                 Int?
  created_at                 DateTime             @default(now())
  modified_by                Int?
  modified_at                DateTime?
  echeances                  EcheanceAbonnement[]
  abonnement                 Abonnement           @relation(fields: [id_abonnement], references: [id_abonnement])

  @@index([canceled_at], map: "idx_souscription_abonnement_canceled", where: raw("(canceled_at IS NULL)"))
  @@index([id_abonnement], map: "idx_souscription_abonnement_id_abonnement")
  @@index([id_collaborateur], map: "idx_souscription_abonnement_id_collaborateur")
  @@index([statut], map: "idx_souscription_abonnement_statut")
  @@map("souscription_abonnement")
}

/// Obligation financière concrète pour une période donnée.
///
/// montant = snapshot figé du montant dû à la génération de cette échéance.
/// Une modification ultérieure de SouscriptionAbonnement.montant ou Abonnement.montant
/// ne modifie JAMAIS une échéance déjà créée.
///
/// statut : en_attente | partiellement_payee | payee | annulee
model EcheanceAbonnement {
  id_echeance_abonnement     Int                    @id @default(autoincrement())
  tenant_id                  Int
  id_souscription_abonnement Int
  /// Snapshot figé du montant dû pour cette période. Jamais recalculé après création.
  montant                    Decimal                @db.Decimal(10, 2)
  periode_debut              DateTime
  periode_fin                DateTime
  /// en_attente | partiellement_payee | payee | annulee
  statut                     String                 @default("en_attente")
  /// Renseigner pour annuler — ne jamais supprimer physiquement.
  canceled_at                DateTime?
  canceled_by                Int?
  created_by                 Int?
  created_at                 DateTime               @default(now())
  modified_by                Int?
  modified_at                DateTime?
  souscription               SouscriptionAbonnement @relation(fields: [id_souscription_abonnement], references: [id_souscription_abonnement])
  paiements                  PaiementAbonnement[]

  @@unique([id_souscription_abonnement, periode_debut], map: "uq_echeance_periode")
  @@index([canceled_at], map: "idx_echeance_abonnement_canceled", where: raw("(canceled_at IS NULL)"))
  @@index([id_souscription_abonnement], map: "idx_echeance_abonnement_id_souscription")
  @@index([statut], map: "idx_echeance_abonnement_statut")
  @@map("echeance_abonnement")
}

/// Encaissement réel pour une échéance.
///
/// montant est indépendant de EcheanceAbonnement.montant :
/// paiement partiel, multiple, ou en erreur sont valides — excédent interdit en V1.
/// Un paiement ne doit jamais être rattaché directement à Abonnement ou SouscriptionAbonnement —
/// il appartient obligatoirement à une EcheanceAbonnement.
///
/// Paiement groupé : plusieurs PaiementAbonnement partagent le même id_transaction_financiere.
/// Dans ce cas : N lignes PaiementAbonnement → 1 seule TransactionFinanciere(IN).
/// source_module = 'ABONNEMENT'
/// source_id     = id_souscription_abonnement
///
/// Annulation : canceled_at / canceled_by — ne jamais supprimer physiquement.
/// L'annulation se fait au niveau du groupe (id_transaction_financiere), pas ligne par ligne.
model PaiementAbonnement {
  id_paiement_abonnement    Int                    @id @default(autoincrement())
  tenant_id                 Int
  id_echeance_abonnement    Int
  /// Montant réellement encaissé sur cette échéance. Indépendant de EcheanceAbonnement.montant.
  montant                   Decimal                @db.Decimal(10, 2)
  date_paiement             DateTime               @default(now())
  /// Relie ce paiement à la TransactionFinanciere commune du groupe.
  /// NULL pour les paiements créés avant cette évolution (rétrocompatibilité).
  /// Si plusieurs PaiementAbonnement partagent le même id_transaction_financiere,
  /// ils font partie du même acte de paiement global.
  id_transaction_financiere Int?
  /// Renseigner pour annuler — ne jamais supprimer physiquement.
  canceled_at               DateTime?
  canceled_by               Int?
  created_by                Int?
  created_at                DateTime               @default(now())
  modified_by               Int?
  modified_at               DateTime?
  echeance                  EcheanceAbonnement     @relation(fields: [id_echeance_abonnement], references: [id_echeance_abonnement])
  transaction_financiere    TransactionFinanciere? @relation(fields: [id_transaction_financiere], references: [id_transaction_financiere])

  @@index([canceled_at], map: "idx_paiement_abonnement_canceled", where: raw("(canceled_at IS NULL)"))
  @@index([id_echeance_abonnement], map: "idx_paiement_abonnement_id_echeance")
  @@index([id_transaction_financiere], map: "idx_paiement_abonnement_id_tf", where: raw("(id_transaction_financiere IS NOT NULL)"))
  @@map("paiement_abonnement")
}

model StockAjustement {
  id_stock_ajustement Int       @id @default(autoincrement())
  id_lot              Int
  id_utilisateur      Int
  type                String
  quantite            Decimal   @db.Decimal(12, 3)
  motif               String?
  date_ajustement     DateTime  @default(now())
  statut              String    @default("valide")
  created_at          DateTime  @default(now())
  created_by          Int?
  updated_at          DateTime?
  updated_by          Int?
  deleted_at          DateTime?

  @@map("stock_ajustement")
}

model RetourCollaborateur {
  id_retour_collaborateur Int       @id @default(autoincrement())
  id_lot                  Int
  id_collaborateur        Int
  id_utilisateur          Int
  quantite_retournee      Decimal   @db.Decimal(12, 3)
  date_retour             DateTime  @default(now())
  motif                   String?
  created_at              DateTime  @default(now())
  created_by              Int?
  updated_at              DateTime?
  updated_by              Int?
  deleted_at              DateTime?

  @@map("retour_collaborateur")
}
